{
  "components": {
    "schemas": {
      "Resources": {
        "description": "Compute requirements used to filter candidate instance types.",
        "properties": {
          "accelerators": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "e.g. {\"A100\": 1}",
            "type": "object"
          },
          "cloud": {
            "type": "string"
          },
          "cpus": {
            "description": "CPU range, e.g. \"8+\", \"4-8\", or a fixed number",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "diskSize": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "instanceType": {
            "type": "string"
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "memory": {
            "description": "Memory in GiB, e.g. \"16+\"",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "region": {
            "type": "string"
          },
          "timeSec": {
            "description": "Estimated runtime in seconds (used by the time objective)",
            "type": "integer"
          },
          "useSpot": {
            "type": "boolean"
          },
          "zone": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Task": {
        "description": "A task to launch: resources to provision plus setup/run commands.",
        "properties": {
          "backend": {
            "description": "Execution backend: cloud|existing|docker|local (default cloud)",
            "type": "string"
          },
          "credentials": {
            "type": "object"
          },
          "docker": {
            "type": "object"
          },
          "envs": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "fileMounts": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "name": {
            "type": "string"
          },
          "numNodes": {
            "description": "Number of nodes (default 1)",
            "type": "integer"
          },
          "resources": {
            "$ref": "#/components/schemas/Resources"
          },
          "run": {
            "description": "Run command on the head node",
            "type": "string"
          },
          "service": {
            "type": "object"
          },
          "setup": {
            "description": "Setup commands run on every node",
            "type": "string"
          },
          "ssh": {
            "type": "object"
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "time": {
            "type": "string"
          },
          "workdir": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "jobRunRequest": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "jobSubmitRequest": {
        "properties": {
          "name": {
            "type": "string"
          },
          "retries": {
            "type": "integer"
          },
          "schedule": {
            "description": "Cron schedule, e.g. '0 0 * * *'",
            "type": "string"
          },
          "task": {
            "description": "Task YAML or task file path",
            "type": "string"
          }
        },
        "type": "object"
      },
      "launchRequest": {
        "properties": {
          "cloud": {
            "description": "Cloud filter",
            "type": "string"
          },
          "clusterName": {
            "type": "string"
          },
          "dryRun": {
            "description": "Only compute the placement plan",
            "type": "boolean"
          },
          "name": {
            "description": "Cluster name (defaults to task name)",
            "type": "string"
          },
          "numNodes": {
            "type": "integer"
          },
          "optimizer": {
            "description": "Placement optimizer or strategy: cost, time, or a priority list like cost,time (default: cost)",
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "runTask": {
            "description": "Start running the task after provisioning",
            "type": "boolean"
          },
          "task": {
            "description": "Task YAML",
            "type": "string"
          },
          "useSpot": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "serviceUpRequest": {
        "properties": {
          "cloud": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "optimizer": {
            "description": "Placement optimizer or strategy (default: cost)",
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "task": {
            "description": "Task YAML with a service block",
            "type": "string"
          }
        },
        "type": "object"
      },
      "taskLaunchRequest": {
        "properties": {
          "cloud": {
            "type": "string"
          },
          "dryRun": {
            "description": "Only compute the placement plan",
            "type": "boolean"
          },
          "numNodes": {
            "type": "integer"
          },
          "optimizer": {
            "description": "Placement optimizer or strategy (default: cost)",
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "runTask": {
            "description": "Start running the task after provisioning",
            "type": "boolean"
          },
          "task": {
            "$ref": "#/components/schemas/Task",
            "description": "Task object (structured JSON)"
          },
          "useSpot": {
            "type": "boolean"
          }
        },
        "required": [
          "task"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "token",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
