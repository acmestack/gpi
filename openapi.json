{
  "components": {
    "schemas": {
      "DockerSpec": {
        "description": "Container execution config (backend: docker).",
        "properties": {
          "envs": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "gpus": {
            "description": "Optional number of host GPUs",
            "type": "integer"
          },
          "image": {
            "type": "string"
          },
          "volumes": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "Resources": {
        "description": "Compute requirements used to filter candidate instance types.",
        "properties": {
          "accelerators": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "e.g. {\"A100\": 1}",
            "type": "object"
          },
          "cloud": {
            "type": "string"
          },
          "cpus": {
            "description": "CPU range, e.g. \"8+\", \"4-8\", or a fixed number",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "diskSize": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "instanceType": {
            "type": "string"
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "memory": {
            "description": "Memory in GiB, e.g. \"16+\"",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "region": {
            "type": "string"
          },
          "timeSec": {
            "description": "Estimated runtime in seconds (used by the time metric)",
            "type": "integer"
          },
          "useSpot": {
            "type": "boolean"
          },
          "zone": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "SSHTarget": {
        "description": "Existing host to attach to (backend: existing).",
        "properties": {
          "host": {
            "type": "string"
          },
          "key": {
            "description": "Optional SSH private key path",
            "type": "string"
          },
          "port": {
            "description": "Optional, default 22",
            "type": "integer"
          },
          "user": {
            "description": "Optional, default root",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ServiceSpec": {
        "description": "Exposes the task as a replicated service.",
        "properties": {
          "healthCheck": {
            "description": "Optional health probe",
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "ports": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "readyServer": {
            "description": "Optional readiness URL",
            "type": "string"
          },
          "replicas": {
            "type": "integer"
          },
          "run": {
            "description": "Optional service run command (defaults to task run)",
            "type": "string"
          },
          "targetConcurrentSessions": {
            "description": "Optional autoscaling target",
            "type": "integer"
          },
          "workingDir": {
            "description": "Optional working directory",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Task": {
        "description": "A task to launch: resources to provision plus setup/run commands.",
        "properties": {
          "backend": {
            "description": "Optional execution backend: cloud|existing|docker|local (default cloud)",
            "type": "string"
          },
          "credentials": {
            "description": "Optional per-cloud access keys: { \u003ccloud\u003e: { accessKeyId, secretAccessKey, region } }",
            "type": "object"
          },
          "docker": {
            "$ref": "#/components/schemas/DockerSpec"
          },
          "envs": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Optional extra environment variables",
            "type": "object"
          },
          "fileMounts": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Optional local files copied to each node (path → remote path)",
            "type": "object"
          },
          "name": {
            "description": "Cluster/task name (optional; generated if empty)",
            "type": "string"
          },
          "numNodes": {
            "description": "Number of nodes, \u003e1 auto-forms Ray cluster (optional, default 1)",
            "type": "integer"
          },
          "resources": {
            "$ref": "#/components/schemas/Resources"
          },
          "run": {
            "description": "Main command executed on the head node",
            "type": "string"
          },
          "service": {
            "$ref": "#/components/schemas/ServiceSpec"
          },
          "setup": {
            "description": "Optional setup script run on every node before the task",
            "type": "string"
          },
          "ssh": {
            "$ref": "#/components/schemas/SSHTarget"
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Optional labels attached to cloud instances",
            "type": "object"
          },
          "workdir": {
            "description": "Optional local working directory uploaded to every node",
            "type": "string"
          }
        },
        "type": "object"
      },
      "jobRunRequest": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "jobSubmitRequest": {
        "properties": {
          "name": {
            "type": "string"
          },
          "optimizer": {
            "description": "Placement optimizer or strategy (default: cost)",
            "type": "string"
          },
          "retries": {
            "type": "integer"
          },
          "schedule": {
            "description": "Cron schedule, e.g. '0 0 * * *'",
            "type": "string"
          },
          "task": {
            "description": "Task YAML or task file path",
            "type": "string"
          }
        },
        "type": "object"
      },
      "launchRequest": {
        "properties": {
          "cloud": {
            "description": "Cloud filter",
            "type": "string"
          },
          "clusterName": {
            "type": "string"
          },
          "dryRun": {
            "description": "Only compute the placement plan",
            "type": "boolean"
          },
          "name": {
            "description": "Cluster name (defaults to task name)",
            "type": "string"
          },
          "numNodes": {
            "type": "integer"
          },
          "optimizer": {
            "description": "Placement optimizer or strategy: cost, time, or a priority list like cost,time (default: cost)",
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "runTask": {
            "description": "Start running the task after provisioning",
            "type": "boolean"
          },
          "task": {
            "description": "Task YAML",
            "type": "string"
          },
          "useSpot": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "serviceUpRequest": {
        "properties": {
          "cloud": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "optimizer": {
            "description": "Placement optimizer or strategy (default: cost)",
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "task": {
            "description": "Task YAML with a service block",
            "type": "string"
          }
        },
        "type": "object"
      },
      "taskLaunchRequest": {
        "properties": {
          "cloud": {
            "type": "string"
          },
          "dryRun": {
            "description": "Only compute the placement plan",
            "type": "boolean"
          },
          "numNodes": {
            "type": "integer"
          },
          "optimizer": {
            "description": "Placement optimizer or strategy (default: cost)",
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "runTask": {
            "description": "Start running the task after provisioning",
            "type": "boolean"
          },
          "task": {
            "$ref": "#/components/schemas/Task",
            "description": "Task object (structured JSON)"
          },
          "useSpot": {
            "type": "boolean"
          }
        },
        "required": [
          "task"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "token",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
